{
  "name": "lowstate-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Lowstate — lower your mental entropy. A retro notebook to-do gadget for Windows and macOS.",
  "author": "Giuliana Pessota",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check app.js && node --check core.js && node --check storage.js && node --check i18n.js && node --check main.cjs && node --check preload.cjs && node --test",
    "dist:mac": "electron-builder --mac --publish=never",
    "dist:win": "electron-builder --win --publish=never"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lowstate.app",
    "productName": "Lowstate",
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "styles.css",
      "storage.js",
      "i18n.js",
      "core.js",
      "app.js",
      "manifest.webmanifest",
      "sw.js",
      "assets/**/*"
    ],
    "afterSign": "scripts/after-sign.cjs",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
