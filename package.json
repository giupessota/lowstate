{
  "name": "lowstate-desktop",
  "version": "2.7.2",
  "private": true,
  "description": "Lowstate — lower your mental entropy. A calm weekly planner for Windows and macOS.",
  "author": "Giuliana Pessota",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check app.js && node --check core.js && node --check planner.js && node --check storage.js && node --check desktop-storage.cjs && node --check desktop-lifecycle.cjs && node --check desktop-calendars.cjs && node --check desktop-sync.cjs && node --check desktop-google.cjs && node --check i18n.js && node --check main.cjs && node --check preload.cjs && node --test",
    "dist:mac": "electron-builder --mac --publish=never",
    "dist:win": "electron-builder --win --publish=never",
    "dist:mac:local": "electron-builder --mac dir --arm64 --publish=never -c.mac.identity=\"Lowstate Local Signing\""
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lowstate.app",
    "productName": "Lowstate",
    "files": [
      "main.cjs",
      "preload.cjs",
      "desktop-storage.cjs",
      "desktop-lifecycle.cjs",
      "desktop-calendars.cjs",
      "desktop-sync.cjs",
      "desktop-google.cjs",
      "google-client.json",
      "index.html",
      "styles.css",
      "storage.js",
      "i18n.js",
      "core.js",
      "planner.js",
      "app.js",
      "manifest.webmanifest",
      "sw.js",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Lowstate adds your shopping list to Reminders when you ask it to. / O Lowstate coloca sua lista de compras no Lembretes quando você pede."
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "ical.js": "2.2.1"
  }
}
